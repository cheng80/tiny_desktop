    "install:macos": "bash tools/install_macos.sh",
    "shoot": "node tools/shoot.mjs --out tmp/shots",
    "icons": "node tools/make_icons.mjs"
  },
  "keywords": [],
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
