{
  "name": "tiny-farm",
  "version": "0.1.0",
  "description": "느긋하게 지켜보는 픽셀 농장 데스크테리어 위젯",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
